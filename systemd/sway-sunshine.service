[Unit]
Description=Headless Sway session for Sunshine streaming
After=graphical-session.target

[Service]
Type=simple
Environment=WLR_BACKENDS=headless,libinput
Environment=LIBSEAT_BACKEND=noop
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=WLR_RENDERER=gles2
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=sway
Environment=SWAYSOCK=/run/user/%U/sway-sunshine.sock
Environment=PULSE_SINK=sink-sunshine-stereo
Environment=LD_PRELOAD=%h/.local/lib/libseat-seat1.so
ExecStartPre=-/bin/rm -f /run/user/%U/sway-sunshine.sock
ExecStartPre=/bin/cp -f /usr/bin/sway %h/.local/bin/sway-seat1
ExecStart=%h/.local/bin/sway-seat1 --config %h/.config/sway-sunshine/config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
